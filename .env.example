# Copy to .env and fill in. .env is git-ignored; never commit real values.
# One username/password pair per portal, using the variable names from config/portals.yaml.
PRIMARY_SMS_USER=
PRIMARY_SMS_PASSWORD=
BACKUP_SMS_USER=
BACKUP_SMS_PASSWORD=
GATEWAY_SMS_USER=
GATEWAY_SMS_PASSWORD=

# Email delivery (leave SMTP_HOST empty to disable). SMTP_SSL=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Microsoft Teams incoming webhook (leave empty to disable).
TEAMS_WEBHOOK_URL=

LOG_LEVEL=INFO
